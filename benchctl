#!/usr/bin/env python3
"""Local Docker control; credentials remain in the server vault."""
import json
from pathlib import Path
import subprocess
import sys
ROOT=Path(__file__).resolve().parent
args=sys.argv[1:]
if args and args[0]=='install-skill':
    raise SystemExit(subprocess.call([sys.executable,str(ROOT/'scripts/install-operator-skill.py'),*args[1:]]))
elif args and args[0]=='journal':
    from server.diagnostics import main
    main(args)
else:
    input_data=None
    if '--prompt-file' in args:
        index=args.index('--prompt-file')
        try:
            path=Path(args[index+1]);prompt=path.read_text()
            if not 0<len(prompt.encode())<=1024*1024:raise ValueError('Prompt vide ou supérieur à 1 Mio.')
        except (IndexError,OSError,ValueError) as error:raise SystemExit(str(error))
        args[index:index+2]=['--input-json']
        input_data=json.dumps({'title':path.stem,'prompt':prompt})
    try:
        command=['docker','compose','exec','-T','bench','python','-m','server.control',*(args or ['--help'])]
        raise SystemExit(subprocess.run(command,cwd=ROOT,input=input_data,text=True).returncode)
    except FileNotFoundError:raise SystemExit('Docker requis. Installation Python : python -m server.control --help')
