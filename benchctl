#!/usr/bin/env python3
"""Local CLI. Docker grants local operator access; no password or API key is copied."""
from pathlib import Path
import subprocess
import sys

ROOT = Path(__file__).resolve().parent

if len(sys.argv) < 2 or sys.argv[1] in ('-h', '--help', 'journal'):
    from server.diagnostics import main
    main(sys.argv[1:] if len(sys.argv) > 1 else ['--help'])
else:
    command = ['docker', 'compose', 'exec', '-T', 'bench', 'python', '-m', 'server.diagnostics', *sys.argv[1:]]
    try:
        raise SystemExit(subprocess.call(command, cwd=ROOT))
    except FileNotFoundError:
        raise SystemExit('Docker est requis. En installation Python : python -m server.diagnostics --help')
