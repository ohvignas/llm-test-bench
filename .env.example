# Optional / Facultatif. Defaults work without a .env file.
# Change this port if 8085 is already in use; restart with docker compose up -d.
BENCH_PORT=8085
# No API key or account password here: configure them in the local web interface.
# Optional only for Docker engines with a nonstandard daemon socket:
# DOCKER_SOCKET_PATH=/var/run/docker.sock
# Linux only if the socket group is not 0: stat -c '%g' /var/run/docker.sock
# DOCKER_SOCKET_GID=0
